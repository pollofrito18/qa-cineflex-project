                 {
                     "name":  "01 - Login JWT",
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "(function () {\npm.test(\"Login responde HTTP 200\", function () {\r\n  pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"La respuesta es JSON\", function () {\r\n  pm.response.to.be.json;\r\n});\r\n\r\nconst data = pm.response.json();\r\n\r\npm.test(\"Inicio de sesion exitoso\", function () {\r\n  pm.expect(data.mensaje).to.eql(\"Inicio de sesión exitoso\");\r\n});\r\n\r\npm.test(\"Token JWT generado correctamente\", function () {\r\n  pm.expect(data.token).to.be.a(\"string\");\r\n  pm.expect(data.token.split(\".\")).to.have.lengthOf(3);\r\n});\r\n\r\npm.test(\"Correo del usuario correcto\", function () {\r\n  pm.expect(data.usuario.email).to.eql(\"cliente@cineflex.com\");\r\n});\r\n\r\nif (pm.response.code === 200 \u0026\u0026 typeof data.token === \"string\") {\r\n  pm.environment.set(\"jwt_token\", data.token);\r\n}\n})();"
                                                               ]
                                                  }
                                   }
                               ],
                     "request":  {
                                     "method":  "POST",
                                     "header":  [

                                                ],
                                     "body":  {
                                                  "mode":  "raw",
                                                  "raw":  "{\r\n  \"email\": \"cliente@cineflex.com\",\r\n  \"password\": \"CineFlex123!\"\r\n}",
                                                  "options":  {
                                                                  "raw":  {
                                                                              "language":  "json"
                                                                          }
                                                              }
                                              },
                                     "url":  {
                                                 "raw":  "{{base_url}}/api/auth/login",
                                                 "host":  [
                                                              "{{base_url}}"
                                                          ],
                                                 "path":  [
                                                              "api",
                                                              "auth",
                                                              "login"
                                                          ]
                                             }
