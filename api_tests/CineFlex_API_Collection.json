                 {
                     "name":  "02 - Cartelera GET",
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "(function () {\npm.test(\"Cartelera responde HTTP 200\", function () {\r\n  pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"La respuesta es JSON\", function () {\r\n  pm.response.to.be.json;\r\n});\r\n\r\nconst data = pm.response.json();\r\n\r\npm.test(\"La respuesta contiene peliculas\", function () {\r\n  pm.expect(data.peliculas).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"Existen 3 peliculas en cartelera\", function () {\r\n  pm.expect(data.total).to.eql(3);\r\n  pm.expect(data.peliculas).to.have.lengthOf(3);\r\n});\r\n\r\npm.test(\"Las peliculas tienen datos correctos\", function () {\r\n  data.peliculas.forEach(function (pelicula) {\r\n    pm.expect(pelicula.id).to.be.a(\"number\");\r\n    pm.expect(pelicula.titulo).to.be.a(\"string\");\r\n    pm.expect(pelicula.precio).to.be.a(\"number\");\r\n    pm.expect(pelicula.horarios).to.be.an(\"array\");\r\n  });\r\n});\r\n\r\npm.test(\"Tiempo de respuesta menor a 300 ms\", function () {\r\n  pm.expect(pm.response.responseTime).to.be.below(300);\r\n});\n})();"
                                                               ]
                                                  }
                                   }
                               ],
