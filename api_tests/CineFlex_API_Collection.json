                 {
                     "name":  "03 - Reserva rechazada",
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "type":  "text/javascript",
                                                      "exec":  [
                                                                   "(function () {\npm.test(\"Reserva rechazada con HTTP 402\", function () {\r\n  pm.response.to.have.status(402);\r\n});\r\n\r\npm.test(\"La respuesta es JSON\", function () {\r\n  pm.response.to.be.json;\r\n});\r\n\r\nconst data = pm.response.json();\r\n\r\npm.test(\"Mensaje de rechazo correcto\", function () {\r\n  pm.expect(data.mensaje).to.eql(\r\n    \"Pago rechazado por el banco simulado\"\r\n  );\r\n});\r\n\r\npm.test(\"Codigo de pago rechazado correcto\", function () {\r\n  pm.expect(data.codigo).to.eql(\"PAGO_RECHAZADO\");\r\n});\r\n\r\npm.test(\"No se genera ticket al rechazar pago\", function () {\r\n  pm.expect(data).to.not.have.property(\"ticket\");\r\n});\n})();"
                                                               ]
                                                  }
                                   }
                               ],
